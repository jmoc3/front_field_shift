<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F4"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Encabezado superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERRA / ACCESO"
            android:textColor="#6E6B64"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu finca empieza aquí"
            android:textColor="#171715"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresa o registra tu finca por primera vez."
            android:textColor="#6E6B64"
            android:textSize="15sp"
            android:layout_marginBottom="22dp" />

        <!-- TARJETA 1: Ingresar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#EFECE6"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresar"
                    android:textColor="#171715"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="tu@correo.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:paddingHorizontal="16dp"
                    android:textColor="#171715"
                    android:textColorHint="#8C8881"
                    android:textSize="15sp"
                    android:layout_marginBottom="18dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEntrar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#141413"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Entrar"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA 2: Registro por primera vez -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#EFECE6"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registro por primera vez"
                    android:textColor="#171715"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRegNombre"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Tu nombre"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords|textNoSuggestions"
                    android:paddingHorizontal="16dp"
                    android:textColor="#171715"
                    android:textColorHint="#8C8881"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Correo electrónico -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="tu@correo.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:paddingHorizontal="16dp"
                    android:textColor="#171715"
                    android:textColorHint="#8C8881"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Ubicación -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación (Municipio/Departamento)"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRegUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Municipio, Departamento"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords|textNoSuggestions"
                    android:paddingHorizontal="16dp"
                    android:textColor="#171715"
                    android:textColorHint="#8C8881"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Hectáreas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hectáreas de la finca (ha)"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRegHectareas"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Superficie en ha"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="16dp"
                    android:textColor="#171715"
                    android:textColorHint="#8C8881"
                    android:textSize="15sp"
                    android:layout_marginBottom="22dp" />

                <!-- Rotación actual -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rotación actual"
                    android:textColor="#171715"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige la secuencia del catálogo EcoCrop."
                    android:textColor="#6E6B64"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Cultivo 1 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cultivo 1"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerCultivo1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="36dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:text="▾"
                        android:textColor="#171715"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Cultivo 2 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cultivo 2"
                    android:textColor="#5C5953"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerCultivo2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="36dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:text="▾"
                        android:textColor="#171715"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Contenedor dinámico para cuando presionen "+ Añadir cultivo" -->
                <LinearLayout
                    android:id="@+id/layoutCultivosExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Botón "+ Añadir cultivo de lista EcoCrop" -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAnadirCultivo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="#EFECE6"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DFDCD4"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="+ Añadir cultivo de lista EcoCrop"
                        android:textColor="#171715"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Principal Inferior: Guardar y entrar a mi finca -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnGuardarRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#141413"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Guardar y entrar a mi finca"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>